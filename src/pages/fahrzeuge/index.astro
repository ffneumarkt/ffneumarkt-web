---
import Layout from "@/layouts/Layout.astro";
import PageTitle from "@/components/shared/heading/PageTitle.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

export const prerender = true;

const vehicles = await getCollection("vehicles");
const sortedVehicles = vehicles.sort((a, b) => {
    const orderDiff = a.data.sortOrder - b.data.sortOrder;
    return orderDiff !== 0 ? orderDiff : a.data.name.localeCompare(b.data.name);
});
---

<Layout title="Fahrzeuge">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 md:py-12">
        <PageTitle>Unser Fuhrpark</PageTitle>

        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8"
        >
            {
                sortedVehicles.map((vehicle) => (
                    <a
                        href={`/fahrzeuge/${vehicle.id}`}
                        class="group block bg-white rounded-lg overflow-hidden card-interactive border border-gray-100"
                    >
                        <div class="aspect-video overflow-hidden rounded-t-lg bg-gray-100 relative">
                            {vehicle.data.gallery && vehicle.data.gallery[0] ? (
                                <Image
                                    src={vehicle.data.gallery[0]}
                                    alt={vehicle.data.name}
                                    width={600}
                                    loading="lazy"
                                    class="object-cover w-full h-full image-interactive"
                                />
                            ) : (
                                <div class="flex items-center justify-center h-full text-secondary">
                                    Kein Bild
                                </div>
                            )}

                            <div class="absolute top-2 right-2 bg-accent text-on-accent text-xs font-bold px-2 py-1 rounded shadow">
                                {vehicle.data.tacticalName}
                            </div>
                        </div>

                        <div class="p-5">
                            <p class="text-xl font-bold text-primary group-hover:text-red-700 mb-2">
                                {vehicle.data.name}
                            </p>
                            <div class="text-sm text-secondary grid grid-cols-2 gap-2">
                                <div>
                                    <span class="block text-xs uppercase">
                                        Besatzung
                                    </span>
                                    {vehicle.data.specs?.crew || "-"}
                                </div>
                                <div>
                                    <span class="block text-xs uppercase">
                                        Leistung
                                    </span>
                                    {vehicle.data.specs?.power || "-"}
                                </div>
                            </div>
                        </div>
                    </a>
                ))
            }
        </div>
    </div>
</Layout>
