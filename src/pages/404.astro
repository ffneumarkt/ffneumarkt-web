---
import Layout from "@/layouts/Layout.astro";

export const prerender = true;
---

<Layout title="404">
    <section class="max-w-3xl mx-auto px-4 py-16 md:py-24 text-center">
        <h1
            class="text-primary text-4xl md:text-5xl font-extrabold tracking-tight mb-4"
        >
            404 - Seite nicht gefunden
        </h1>

        <p class="text-secondary text-lg leading-relaxed pb-10">
            Die angeforderte Seite existiert nicht oder wurde verschoben.
        </p>

        <div class="flex flex-col sm:flex-row justify-center gap-4">
            <a
                href="/"
                class="bg-accent text-on-accent px-6 py-3 rounded-lg font-bold transition-all hover:-translate-y-0.5"
            >
                Zur Startseite
            </a>
            <a
                href="/kontakt"
                class="bg-white border border-slate-200 text-primary px-6 py-3 rounded-lg font-bold transition-all hover:-translate-y-0.5"
            >
                Kontakt
            </a>
        </div>
    </section>
</Layout>
