---
type HeadingLevel = 1 | 2 | 3 | 4 | 5 | 6;
type HeadingSize = "sm" | "md" | "lg";

interface Props {
    level?: HeadingLevel;
    size?: HeadingSize;
    additionalClasses?: string;
}

const { level = 2, size = "md", additionalClasses = "" } = Astro.props;

const sizeSpecificClasses = (() => {
    if (size === "lg") {
        return "text-3xl sm:text-4xl md:text-5xl border-l-8 pl-6 mb-10";
    }
    if (size === "md") {
        return "text-xl sm:text-2xl md:text-3xl border-l-4 md:border-l-8 pl-3 md:pl-4";
    }
    return "text-lg sm:text-xl border-l-4 pl-3";
})();

const HeadingTag = `h${level}` as `h${HeadingLevel}`;
---

<HeadingTag
    class=`font-bold border-accent text-primary uppercase tracking-wider break-normal leading-tight ${sizeSpecificClasses} ${additionalClasses}`
>
    <slot />
</HeadingTag>
