---
interface Props {
    icon: string;
    title: string;
    subtext: string;
    href?: string;
    linkDescription?: string;

    dark?: boolean;
    largeLink?: boolean;
    showArrow?: boolean;
    openInNewTab?: boolean;
}
const {
    icon,
    title,
    subtext,
    href,
    linkDescription,
    dark,
    largeLink,
    showArrow,
    openInNewTab,
} = Astro.props;
---

<a
    href={href}
    target={openInNewTab ? "_blank" : undefined}
    rel={openInNewTab ? "noopener noreferrer" : undefined}
    class={`p-8 rounded-2xl shadow-xl border hover:shadow-2xl  transition-all duration-300 transform hover:-translate-y-1 flex flex-col items-center text-center${
        dark
            ? "group bg-dark-bg shadow-slate-900/20  border-slate-800"
            : "group bg-white   shadow-slate-200/50  border-slate-100"
    }`}
>
    <div
        class="text-5xl mb-6 group-hover:scale-110 transition-transform duration-300"
    >
        {icon}
    </div>
    <h2
        class={`text-xl font-bold mb-3 ${dark ? "text-dark-primary" : "text-primary"}`}
    >
        {title}
    </h2>
    <p
        class={`mb-6 leading-relaxed text-center whitespace-pre-line ${dark ? "text-dark-secondary" : "text-secondary"}`}
    >
        {subtext}
    </p>
    {
        href && (
            <span
                class={`font-bold mt-auto ${dark ? "text-dark-primary" : "text-accent-vivid"} ${largeLink ? "text-xl" : "text-sm"}`}
            >
                {linkDescription || href}
                {showArrow ? " →" : ""}
            </span>
        )
    }
</a>
