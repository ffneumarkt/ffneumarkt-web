---
type HeroTextBlockProps = {
  heroKicker: string;
  fireBrigadeName: string;
  location: string;
  heroTagline: string;
};

const { heroKicker, fireBrigadeName, location, heroTagline } = Astro.props as HeroTextBlockProps;
---

<div class="space-y-4">
  <div class="inline-flex items-center gap-2 py-2 px-4 rounded-full bg-red-50 border border-red-200 text-red-700 text-xs font-bold tracking-[0.3em] uppercase">
    <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
    {heroKicker}
  </div>
  <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 uppercase">
    <span class="block">{fireBrigadeName}</span>
    <span class="block text-red-700">{location}</span>
  </h1>
  <p class="mt-6 max-w-2xl text-lg sm:text-xl text-slate-700">{heroTagline}</p>
</div>
