---
type FactCardProps = {
  title: string;
  description: string;
};

const { title, description } = Astro.props as FactCardProps;
---

<div class="w-full bg-white p-6 md:p-8 rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-100 ring-1 ring-slate-900/5">
  <p class="text-xs uppercase tracking-widest text-slate-500 font-bold mb-2">{title}</p>
  <p class="text-xl md:text-2xl font-bold text-slate-800 leading-snug">{description}</p>
</div>
