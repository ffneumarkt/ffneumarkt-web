---
interface GalleryImage {
    src: string;
    width: number;
    height: number;
}

interface Props {
    images: GalleryImage[];
    interval?: number;
}

const { images, interval = 5000 } = Astro.props;
---

<div
    class="relative flex flex-col gap-4"
    data-carousel-root
    data-carousel-interval={interval}
>
    <div
        class="group relative aspect-video overflow-hidden rounded-lg bg-global-bg"
    >
        {
            images.length > 1 && (
                <button
                    class="absolute left-4 top-1/2 z-10 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-dark-bg/30 text-on-accent opacity-100 transition-all duration-200 hover:scale-110 hover:bg-accent md:opacity-0 md:group-hover:opacity-100"
                    data-carousel-prev
                    aria-label="Vorheriges Bild"
                    type="button"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="2.5"
                        stroke="currentColor"
                        class="w-6 h-6"
                    >
                        <title>Vorheriges Bild</title>
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M15.75 19.5L8.25 12l7.5-7.5"
                        />
                    </svg>
                </button>
            )
        }

        {
            images.map((image, index) => (
                <img
                    src={image.src}
                    class={`h-full w-full object-contain ${index === 0 ? "block" : "hidden"}`}
                    data-carousel-slide
                    alt={`Fahrzeugansicht ${index + 1}`}
                    loading={index === 0 ? "eager" : "lazy"}
                    decoding="async"
                />
            ))
        }

        {
            images.length > 1 && (
                <button
                    class="absolute right-4 top-1/2 z-10 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-dark-bg/30 text-on-accent opacity-100 transition-all duration-200 hover:scale-110 hover:bg-accent md:opacity-0 md:group-hover:opacity-100"
                    data-carousel-next
                    aria-label="Nächstes Bild"
                    type="button"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="2.5"
                        stroke="currentColor"
                        class="w-6 h-6"
                    >
                        <title>Nächstes Bild</title>
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M8.25 4.5l7.5 7.5-7.5 7.5"
                        />
                    </svg>
                </button>
            )
        }
    </div>

    {
        images.length > 1 && (
            <div class="flex gap-2 overflow-x-auto pb-1 [scrollbar-width:thin]">
                {images.map((image, index) => (
                    <button
                        class={`shrink-0 overflow-hidden rounded-md border-2 p-0 transition-all duration-200 hover:opacity-100 ${index === 0 ? "border-accent opacity-100" : "border-transparent opacity-60"}`}
                        data-carousel-thumb
                        data-carousel-index={index}
                        type="button"
                    >
                        <img
                            src={image.src}
                            class="block h-[60px] w-[80px] object-cover"
                            alt={`Vorschau ${index + 1}`}
                            loading="lazy"
                            decoding="async"
                        />
                    </button>
                ))}
            </div>
        )
    }
</div>

<script>
    import { initVehicleCarousel } from "@/utils/carousel";

    initVehicleCarousel();
    document.addEventListener("astro:page-load", initVehicleCarousel);
</script>
