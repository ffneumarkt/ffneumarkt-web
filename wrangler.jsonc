{
	"name": "ffneumarkt-web",
	"workers_dev": false,
	"preview_urls": false,
	"main": "./dist/_worker.js/index.js",
	"compatibility_date": "2026-01-26",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"build": {
		"command": "mkdir -p dist && printf '_worker.js\\n_routes.json\\n' > dist/.assetsignore"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	}
}